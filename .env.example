NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ordering_system?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=300

KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=ordering-system
KAFKA_GROUP_ID=ordering-system-consumer
KAFKA_ORDER_CREATED_TOPIC=order.created
KAFKAJS_NO_PARTITIONER_WARNING=1
